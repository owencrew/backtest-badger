{
  "name": "backtest-badger-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack && node --import tsx scripts/prepare-static.ts",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "format:check": "prettier --check app components lib scripts/*.ts tests/*.ts next.config.ts wrangler.jsonc package.json",
    "test:export": "node --import tsx --test tests/export.test.ts",
    "test:workers": "node --import tsx scripts/smoke-workers.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "lightweight-charts": "^5.2.1",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.153.0"
  }
}
