[Unit]
Description=Check the current forward horizon every five minutes UTC
ConditionPathExists=/etc/backtest-badger/workers-approved

[Timer]
OnCalendar=*-*-* *:01/5:00 UTC
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=backtest-badger-collection.service

[Install]
WantedBy=timers.target
