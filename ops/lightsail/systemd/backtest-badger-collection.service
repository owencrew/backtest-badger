[Unit]
Description=Backtest Badger forward collection (Stage 3B)
Wants=network-online.target time-sync.target
Requires=docker.service
After=network-online.target time-sync.target docker.service
ConditionPathExists=/etc/backtest-badger/workers-approved
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/backtest-badger/current
EnvironmentFile=/etc/backtest-badger/worker.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStartPre=/opt/backtest-badger/current/.venv/bin/python ops/lightsail/validate.py runtime --worker collection
ExecStartPre=/opt/backtest-badger/current/.venv/bin/badger db-health
ExecStart=/opt/backtest-badger/current/.venv/bin/badger forward-cycle
TimeoutStartSec=900
TimeoutStopSec=15
KillMode=control-group
Restart=no
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/backtest-badger/artifacts/forward-predictions /var/lib/backtest-badger/artifacts/forward-operations /var/lib/backtest-badger/artifacts/rest
MemoryHigh=1280M
MemoryMax=1536M
MemorySwapMax=512M
CPUQuota=150%
TasksMax=64
StandardOutput=journal
StandardError=journal
SyslogIdentifier=badger-collection
