# /etc/backtest-badger/worker.env, root:ubuntu 0640.
# A separate nonsuperuser role created/granted in D2; not the bootstrap admin.
# Plain literal values only: random hex passwords avoid parser differences.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=backtest_badger
POSTGRES_USER=badger_worker
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
LOG_LEVEL=INFO
