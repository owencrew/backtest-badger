[Unit]
Description=Validated public forward snapshot (isolated from research jobs)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Retained evidence is owner-only (0600, including future atomic writes).
# Reuse its UID inside a restricted filesystem; do not widen evidence ACLs.
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/backtest-badger-public-feed
EnvironmentFile=/etc/backtest-badger-public-feed/publisher.env
Environment=PYTHONPATH=/opt/backtest-badger-public-feed/src
Environment=PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
Environment=AWS_EC2_METADATA_DISABLED=true
ExecStart=/usr/bin/time -f "elapsed_seconds=%%e cpu_user_seconds=%%U cpu_system_seconds=%%S peak_rss_kib=%%M" /opt/backtest-badger-public-feed/.venv/bin/python web/scripts/stage_forward_snapshot.py --records /run/badger-feed-evidence/predictions --outcomes /run/badger-feed-evidence/outcomes --operations /run/badger-feed-evidence/operations --output /var/lib/backtest-badger-public-feed/last-success.json --node /opt/backtest-badger-public-feed/node/bin/node --validator /opt/backtest-badger-public-feed/web/validator.cjs --publish-r2-object backtest-badger-forward/forward-v1.json
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryHigh=384M
MemoryMax=512M
TasksMax=32
TimeoutStartSec=150
KillMode=control-group
Restart=no
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/backtest-badger-public-feed
BindReadOnlyPaths=/var/lib/backtest-badger/artifacts/forward-predictions:/run/badger-feed-evidence/predictions
BindReadOnlyPaths=/var/lib/backtest-badger/artifacts/forward-outcomes:/run/badger-feed-evidence/outcomes
BindReadOnlyPaths=/var/lib/backtest-badger/artifacts/forward-operations:/run/badger-feed-evidence/operations
InaccessiblePaths=/opt/backtest-badger /var/lib/backtest-badger -/etc/backtest-badger -/run/postgresql -/run/docker.sock
CPUAccounting=true
MemoryAccounting=true
IOAccounting=true
StandardOutput=journal
StandardError=journal
